auto-update = download
auto-update-channel = stable
clipboard-read = allow
confirm-close-surface = false
copy-on-select = true
cursor-style = underline
cursor-style-blink = true
custom-shader-animation = false
font-family = "Cascadia Code"
font-size = 16
quick-terminal-animation-duration = 0
resize-overlay = never
macos-titlebar-style = hidden
background-opacity = 0.85
background-blur-radius = 20
macos-titlebar-style = hidden
window-padding-x = 5
window-padding-y = 10

# gotham-default: https://terminalcolors.com/themes/gotham/default/

background = #0c1014
foreground = #99d1ce
selection-background = #0a3749
selection-foreground = #99d1ce
cursor-color = #99d1ce
cursor-text = #11151c
palette = 0=#0c1014
palette = 1=#c23127
palette = 2=#2aa889
palette = 3=#edb443
palette = 4=#195466
palette = 5=#4e5166
palette = 6=#33859e
palette = 7=#99d1ce
palette = 8=#0c1014
